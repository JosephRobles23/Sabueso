{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:www.shadcn.io)",
      "WebFetch(domain:www.brandcolorcode.com)",
      "WebFetch(domain:mobbin.com)",
      "WebFetch(domain:beginswithai.com)",
      "WebFetch(domain:fontofweb.com)",
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_files",
      "Bash(Get-ChildItem -Path \"C:\\\\Users\\\\Joseph Robles\\\\Desktop\\\\Sabueso\" -File)",
      "Bash(Select-Object -ExpandProperty Name)",
      "Bash(pnpm -v)",
      "Bash(pnpm install *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" -H \"X-Emdash-Token: $EMDASH_HOOK_TOKEN\" -H \"X-Emdash-Pty-Id: $EMDASH_PTY_ID\" -H \"X-Emdash-Event-Type: notification\" -d @- \"http://127.0.0.1:$EMDASH_HOOK_PORT/hook\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" -H \"X-Emdash-Token: $EMDASH_HOOK_TOKEN\" -H \"X-Emdash-Pty-Id: $EMDASH_PTY_ID\" -H \"X-Emdash-Event-Type: stop\" -d @- \"http://127.0.0.1:$EMDASH_HOOK_PORT/hook\" || true"
          }
        ]
      }
    ]
  }
}
