# ===========================================
# SABUESO · Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- API Service (Cloud Run) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Production: https://sabueso-api-HASH.run.app

# --- OpenRouter (LLM Gateway) ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- Anthropic (direct, fallback for prompt caching) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- LangSmith (observability) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=sabueso-hack

# --- GCP ---
GCP_PROJECT_ID=sabueso-hack-2026
GCP_REGION=southamerica-east1
GCS_BUCKET_JNE_PDFS=sabueso-jne-pdfs
GCS_BUCKET_DOSSIERS=sabueso-dossiers

# --- Vercel KV (rate limiting) ---
VERCEL_KV_REST_API_URL=https://YOUR_KV.kv.vercel-storage.com
VERCEL_KV_REST_API_TOKEN=...

# --- Zavu (WhatsApp alerts, sponsor) ---
ZAVU_API_KEY=...
ZAVU_SENDER_NUMBER=+51...

# --- App Config ---
INVESTIGATION_COST_LIMIT_USD=3.00
RATE_LIMIT_ANON_PER_DAY=10
RATE_LIMIT_AUTH_PER_DAY=50
LOG_LEVEL=INFO
